<odoo>
    <record id="view_move_form_fe" model="ir.ui.view">
        <field name="name">account.move.form.fe</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_send_fe_agt" type="object" string="Reenviar FE a AGT" class="btn-warning" 
                        invisible="state != 'posted' or fe_status in ('validated', 'processing', 'sent')"/>
                
                <button name="action_download_fe" type="object" string="Baixar Factura Electrónica" class="btn-success" 
                        invisible="fe_status not in ('validated', 'cancelled')"/>
                
                <button name="open_payload_wizard" type="object" string="Payload JSON" class="btn-success"/>
                
                <button name="open_obter_estado_wizard" type="object" string="Obter Estado" class="btn-primary"
                        invisible="not fe_request_id"/>
                
                <button name="open_consultar_factura_wizard" type="object" string="Consultar Factura" class="btn-secondary"/>
                <button name="open_listar_facturas_wizard" type="object" string="Listar Facturas" class="btn-secondary"/>
                
                <button name="action_sync_status_from_query" type="object" string="Sincronizar com AGT" class="btn-info"
                        invisible="fe_status != 'error'"/>
                
                <button name="action_force_manual_validate" type="object" string="Validar Manualmente" class="btn-danger"
                        groups="account.group_account_manager"
                        confirm="Tem a certeza que deseja validar manualmente? Use isto apenas se o documento já existir no portal da AGT."
                        invisible="fe_status != 'error'"/>

                <button name="action_open_cancel_fe_wizard" type="object" string="Anular Factura (AGT)" class="btn-danger"
                        invisible="fe_status != 'validated'"/>
            </header>

            <!-- Ocultar botões padrão do Odoo para limpar a interface -->
            <xpath expr="//header//button[@name='action_invoice_sent']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header//button[@name='preview_invoice']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header//button[@name='button_cancel']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            
            <!-- Restringir o botão Cancelar do Odoo OPC ao fe_status permitido -->
            <xpath expr="//header//button[@name='%(opc_certification_ao_v17.action_wizard_cancelar_fatura)d']" position="attributes">
                <attribute name="invisible">state != 'posted' or fe_status not in ('error', 'not_sent')</attribute>
            </xpath>
            <xpath expr="//header//button[@name='button_request_cancel']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header//button[@name='button_draft']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            
            <field name="state" position="before">
                <field name="fe_status" widget="statusbar" statusbar_visible="not_sent,processing,sent,validated,error"/>
            </field>

            <!-- Nova posição para o campo referência, debaixo do Diário -->
            <xpath expr="//div[@name='journal_div']" position="after">
                <field name="ref" string="Referência do Cliente" invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>

            <!-- Esconder o campo e a label padrão na aba Outra Informação (grupo FATURA) -->
            <xpath expr="//group[@name='sale_info_group']//label[@for='ref']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='sale_info_group']//field[@name='ref']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Adaptação para Notas de Crédito com Documento Histórico: Libertar a obrigatoriedade dos campos standard. -->
            <xpath expr="//field[@name='invoice_origin_id']" position="attributes">
                <attribute name="required">move_type == 'out_refund' and l10n_ao_fe_origin_type != 'legacy'</attribute>
                <attribute name="invisible">move_type != 'out_refund' or l10n_ao_fe_origin_type == 'legacy'</attribute>
            </xpath>
            <xpath expr="//field[@name='reason_cancel']" position="attributes">
                <attribute name="required">move_type == 'out_refund' and l10n_ao_fe_origin_type != 'legacy'</attribute>
                <attribute name="invisible">move_type != 'out_refund' or l10n_ao_fe_origin_type == 'legacy'</attribute>
            </xpath>


            <xpath expr="//notebook" position="inside">
                <page string="Facturação Electrónica (AGT)" name="agt_fe">
                    <group string="Referência a Documentos de Origem (Estornos e Notas de Débito)">
                        <group>
                            <field name="l10n_ao_fe_origin_type" widget="radio" options="{'horizontal': true}"/>
                        </group>
                        <group invisible="l10n_ao_fe_origin_type != 'legacy'">
                            <field name="l10n_ao_fe_legacy_origin_number" required="l10n_ao_fe_origin_type == 'legacy'"/>
                            <field name="l10n_ao_fe_legacy_origin_date" required="l10n_ao_fe_origin_type == 'legacy'"/>
                            <field name="l10n_ao_fe_legacy_reason" required="l10n_ao_fe_origin_type == 'legacy'"/>
                        </group>
                    </group>
                    <group>
                        <group string="Identificadores">
                            <field name="l10n_ao_fe_serie_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="fe_request_id"/>
                            <field name="fe_submission_uuid"/>
                            <field name="fe_document_hash"/>
                        </group>
                        <group string="Estado e Datas">
                            <field name="fe_status"/>
                            <field name="fe_sent_datetime"/>
                            <field name="fe_qr_code" widget="image" readonly="1" invisible="not fe_qr_code" style="width: 150px; height: 150px;"/>
                        </group>
                    </group>
                    <group string="Assinaturas JWS">
                        <field name="fe_jws_software_signature"/>
                        <field name="fe_jws_document_signature"/>
                    </group>
                    <group string="Logs">
                         <field name="fe_last_response"/>
                         <field name="fe_error_list"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_invoice_tree_inherit_fe_v5" model="ir.ui.view">
        <field name="name">account.invoice.tree.inherit.fe.v5</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="fe_status" string="Estado FE" widget="badge" 
                       decoration-success="fe_status == 'validated'" 
                       decoration-info="fe_status in ('sent', 'processing')" 
                       decoration-danger="fe_status == 'error'"
                       invisible="0"/>
            </xpath>
        </field>
    </record>
</odoo>