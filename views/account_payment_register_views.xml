<odoo>
    <record id="view_account_payment_register_form_fe" model="ir.ui.view">
        <field name="name">account.payment.register.form.fe</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <!-- Adicionar campo Série FE após o campo de Memorando -->
            <field name="communication" position="after">
                <field name="l10n_ao_fe_serie_id" 
                       options="{'no_create': True}"
                       force_save="1"
                       domain="[('document_class_id.code', 'in', ['RC', 'RG'])]"/>
            </field>
        </field>
    </record>
</odoo>
