<odoo>
    <template id="report_invoice_document_inherit_fe" inherit_id="account.report_invoice_document">
        <!-- Adicionar a Ref. Doc.(Origem) antes do bloco de informações, para aparecer logo por baixo do título da factura -->
        <xpath expr="//div[@id='informations']" position="before">
            <!-- Marca de Água para Homologação (Testes) -->
            <t t-set="is_hml" t-value="'sifphml' in env['ir.config_parameter'].sudo().get_param('l10n_ao_fe.base_url', '')"/>
            <t t-if="is_hml">
                <div class="watermark" style="position: fixed; top: 35%; left: -5%; width: 110%; text-align: left; padding-left: 10%; opacity: 0.2; z-index: 10; transform: rotate(-25deg); color: red; pointer-events: none; font-weight: bold; line-height: 1.1;">
                    <span style="font-size: 3em;">AMBIENTE DE</span><br/>
                    <span style="font-size: 3em;">HOMOLOGAÇÃO</span><br/>
                    <span style="font-size: 0.9em;">DOCUMENTO EMITIDO PARA FINS DE FORMAÇÃO / DEMONSTRAÇÃO - SEM VALIDADE FISCAL</span>
                </div>
            </t>

            <t t-if="o.ref">
                <div class="mt-2 mb-3" style="font-family: Arial, Helvetica, sans-serif; font-size: 10pt; color: #000000;">
                    <strong>Ref. Doc.(Origem):</strong>
                    <br/>
                    <span t-field="o.ref"/>
                </div>
            </t>
        </xpath>

        <!-- Movemos o QR Code e Info AGT para o Rodapé, abaixo das coordenadas bancárias -->
        <xpath expr="//div[@id='qrcode']" position="after">
            <t t-if="o.fe_qr_code">
                <div class="row mt-2 pt-2" style="font-family: Arial, Helvetica, sans-serif; color:#000000; border-top: 1px solid #eee; page-break-inside: avoid;">
                    <div class="col-2 text-start">
                        <img t-att-src="'data:image/png;base64,%s' % o.fe_qr_code.decode('utf-8')" style="width: 80px; height: 80px;"/>
                    </div>
                    <div class="col-10" style="padding-top: 15px;">
                        <p class="mb-1" style="font-size: 9pt; white-space: nowrap;">
                            <span t-esc="o.fe_document_hash if o.fe_document_hash else ''"/> - <strong>Processado por programa certificado n.º FE/85/AGT/2025</strong> - <strong>InvoiceOne</strong>
                        </p>
                        <p class="text-muted" style="font-size: 8pt; white-space: nowrap;">
                            Este documento serve de prova de transmissão à AGT. Verifique a validade lendo o QR Code.
                        </p>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>