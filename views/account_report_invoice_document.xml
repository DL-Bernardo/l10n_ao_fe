<odoo>
    <template id="report_invoice_document_inherit_fe" inherit_id="account.report_invoice_document">
        <xpath expr="//table[@name='invoice_line_table']" position="after">
            <t t-if="o.fe_qr_code">
                <div class="row mt-4" style="page-break-inside: avoid; border-top: 1px solid #dee2e6; padding-top: 15px; margin-top: 30px;">
                    <div class="col-3 text-center">
                        <div style="display: inline-block; border: 1px solid #eee; padding: 5px; background: #fff;">
                            <img t-att-src="'data:image/png;base64,%s' % o.fe_qr_code.decode('utf-8')" style="width: 120px; height: 120px;"/>
                        </div>
                    </div>
                    <div class="col-9" style="font-size: 11px; line-height: 1.6;">
                        <p class="mb-1">
                            <strong>CONTROLO AGT:</strong> <span t-esc="o.fe_document_hash if o.fe_document_hash else ''"/>
                        </p>
                        <p class="mb-1">
                            <strong>Processado por programa certificado n.º FE/85/AGT/2025</strong>
                        </p>
                        <p class="mb-0 mt-3 text-muted" style="font-size: 9px;">
                            Consulte a validade deste documento no Portal do Contribuinte via QR Code ou no site oficial do MINFIN.
                            Este documento eletrónico foi gerado e assinado conforme a legislação angolana em vigor.
                        </p>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>