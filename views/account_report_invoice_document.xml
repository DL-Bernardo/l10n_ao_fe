<odoo>
    <template id="report_invoice_document_inherit_fe" inherit_id="account.report_invoice_document">
        <xpath expr="//table[@name='invoice_line_table']" position="after">
            <t t-if="o.fe_qr_code">
                <div class="row mt-4" style="page-break-inside: avoid;">
                    <div class="col-4 text-center">
                        <div style="border: 1px solid #ccc; padding: 10px; display: inline-block;">
                            <img t-att-src="'data:image/png;base64,%s' % o.fe_qr_code.decode('utf-8')" style="width: 120px; height: 120px;"/>
                        </div>
                        <div class="mt-1" style="font-size: 10px;">
                            <strong>Processado por Computador</strong>
                        </div>
                    </div>
                    <div class="col-8" style="font-size: 10px; word-wrap: break-word;">
                        <div t-if="o.fe_document_hash">
                            <!-- Mostrar apenas os 4 últimos caracteres do Hash/Assinatura -->
                            <strong>Hash:</strong> <span t-esc="o.fe_document_hash[-4:] if o.fe_document_hash else ''"/>
                        </div>
                        <!-- Assinatura de Software removida para limpar layout -->
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>