<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_tax_form_l10n_ao_fe" model="ir.ui.view">
            <field name="name">account.tax.form.l10n_ao_fe</field>
            <field name="model">account.tax</field>
            <field name="inherit_id" ref="account.view_tax_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='amount_type']" position="after">
                    <field name="l10n_ao_fe_exemption_code"
                           invisible="amount_type != 'is_exempt'"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
