<odoo>
    <data>
        <record id="view_fe_log_tree" model="ir.ui.view">
            <field name="name">l10n_ao.fe.log.tree</field>
            <field name="model">l10n_ao.fe.log</field>
            <field name="arch" type="xml">
                <tree string="Logs FE AGT" create="false" edit="false">
                    <field name="timestamp"/>
                    <field name="name"/>
                    <field name="type"/>
                    <field name="http_status"/>
                    <field name="move_id"/>
                    <field name="request_id"/>
                </tree>
            </field>
        </record>

        <record id="view_fe_log_form" model="ir.ui.view">
            <field name="name">l10n_ao.fe.log.form</field>
            <field name="model">l10n_ao.fe.log</field>
            <field name="arch" type="xml">
                <form string="Log FE AGT" create="false" edit="false">
                    <sheet>
                        <group>
                            <group>
                                <field name="timestamp"/>
                                <field name="name"/>
                                <field name="type"/>
                            </group>
                            <group>
                                <field name="url"/>
                                <field name="http_status"/>
                                <field name="move_id"/>
                                <field name="request_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Payload">
                                <field name="payload" widget="ace" options="{'mode': 'json'}"/>
                            </page>
                            <page string="Response">
                                <field name="response" widget="ace" options="{'mode': 'json'}"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_fe_log" model="ir.actions.act_window">
            <field name="name">Logs de Comunicação AGT</field>
            <field name="res_model">l10n_ao.fe.log</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Sem logs registados.
              </p>
            </field>
        </record>

        <menuitem id="menu_fe_log"
                  name="Logs de Comunicação"
                  parent="account.menu_finance_configuration"
                  action="action_fe_log"
                  sequence="100"/>
    </data>
</odoo>
