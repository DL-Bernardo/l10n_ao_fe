<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View para Séries de FE -->
        <record id="view_l10n_ao_fe_serie_tree" model="ir.ui.view">
            <field name="name">l10n_ao.fe.serie.tree</field>
            <field name="model">l10n_ao.fe.serie</field>
            <field name="arch" type="xml">
                <tree>
                    <header>
                        <button name="action_update_agt_series_list" string="Sincronizar Lista de Séries da AGT" type="object" class="btn-primary"/>
                    </header>
                    <field name="name"/>
                    <field name="document_class_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="sequence_id"/>
                    <field name="agt_status" widget="badge" decoration-success="agt_status == 'active'" decoration-warning="agt_status == 'pending'" decoration-danger="agt_status in ('rejected', 'expired')"/>
                    <field name="active"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </tree>
            </field>
        </record>

        <!-- Form View para Séries de FE -->
        <record id="view_l10n_ao_fe_serie_form" model="ir.ui.view">
            <field name="name">l10n_ao.fe.serie.form</field>
            <field name="model">l10n_ao.fe.serie</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Ex: S2025"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="document_class_id"/>
                                <field name="sequence_id"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="start_date"/>
                                <field name="end_date"/>
                                <field name="agt_status" widget="badge" decoration-success="agt_status == 'active'" decoration-warning="agt_status == 'pending'" decoration-danger="agt_status in ('rejected', 'expired')"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action para Séries de FE -->
        <record id="action_l10n_ao_fe_serie" model="ir.actions.act_window">
            <field name="name">Séries de Facturação Electrónica</field>
            <field name="res_model">l10n_ao.fe.serie</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Nenhuma série de faturação eletrónica encontrada.
                </p><p>
                    Clique em "Sincronizar Lista de Séries da AGT" para obter as séries já existentes ou solicite uma nova.
                </p>
            </field>
        </record>

        <!-- Menu Principal -->
        <menuitem
            id="menu_l10n_ao_fe_root"
            name="Facturação Electrónica (AGT)"
            parent="account.menu_finance_configuration"
            sequence="99"
            groups="account.group_account_manager"/>

        <!-- Menu para Séries -->
        <menuitem
            id="menu_l10n_ao_fe_series"
            name="Séries de Faturação"
            parent="menu_l10n_ao_fe_root"
            action="action_l10n_ao_fe_serie"
            sequence="10"/>

    </data>
</odoo>
