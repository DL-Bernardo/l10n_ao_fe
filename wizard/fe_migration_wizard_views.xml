<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fe_migration_wizard_form" model="ir.ui.view">
        <field name="name">l10n_ao_fe.migration.wizard.form</field>
        <field name="model">l10n_ao_fe.migration.wizard</field>
        <field name="arch" type="xml">
            <form string="Registar Saldo de Migração na AGT">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>Aviso:</strong> Este assistente cria uma Fatura técnica (FT) para regularizar saldos anteriores (SAF-T) no sistema de Facturação Electrónica. 
                        A fatura será emitida com a data de hoje e imposto isento (M10).
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="amount"/>
                            <field name="original_invoice_ref" placeholder="Ex: FT FA2024/005"/>
                        </group>
                        <group>
                            <field name="l10n_ao_fe_serie_id"/>
                            <field name="migration_account_id" groups="account.group_account_readonly"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_register_migration" string="Gerar Fatura e Registar na AGT" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fe_migration_wizard" model="ir.actions.act_window">
        <field name="name">AGT: Migrar Saldo Histórico</field>
        <field name="res_model">l10n_ao_fe.migration.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">form</field>
        <field name="groups_id" eval="[(4, ref('base.group_erp_manager'))]"/>
        <field name="context">{'default_partner_id': active_id}</field>
    </record>

    <!-- Inherit Partner Form to add a button inside the sheet -->
    <record id="view_partner_form_migration_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.migration.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="%(l10n_ao_fe.action_fe_migration_wizard)d" 
                            string="AGT: Migrar Saldo Histórico" 
                            type="action" 
                            class="btn-primary" 
                            groups="base.group_erp_manager"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
